# AppDaemon secrets — copy to secrets.yaml and fill in values.
# This file lives at /addon_configs/appdaemon/secrets.yaml
# It is SEPARATE from Home Assistant's secrets.yaml.

flume_client_id: "your_flume_client_id"
flume_client_secret: "your_flume_client_secret"
flume_username: "your_flume_email@example.com"
flume_password: "your_flume_account_password"
