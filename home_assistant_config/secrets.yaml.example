# Copy this file to secrets.yaml and fill in your values.
# NEVER commit secrets.yaml to git — it is in .gitignore.

# ── Home Assistant ─────────────────────────────────────────────────────────────
ha_base_url: "http://homeassistant.local:8123"
ha_token: "your_long_lived_access_token_here"

# ── Milwaukee Municipal Services ───────────────────────────────────────────────
# Garbage/recycling JSON endpoint. Replace ADDRESS with your address (no spaces):
#   e.g., 2930N39thStreet
# Full URL example: https://itmdapps.milwaukee.gov/DpwServletsPublic/garbage_day?address=2930N39thStreet
milwaukee_garbage_url: "https://itmdapps.milwaukee.gov/DpwServletsPublic/garbage_day?address=YOUR_ADDRESS_HERE"

# Your home coordinates (used for ArcGIS proximity queries)
home_latitude: "43.072241"
home_longitude: "-87.961785"

# ── Flume Water Monitor ────────────────────────────────────────────────────────
flume_client_id: "your_flume_client_id"
flume_client_secret: "your_flume_client_secret"
flume_username: "your_flume_email@example.com"
flume_password: "your_flume_password"

# ── Pi-hole ────────────────────────────────────────────────────────────────────
pihole_url: "http://192.168.1.51"
pihole_token: "your_pihole_api_token"

# ── Rehoboam API ───────────────────────────────────────────────────────────────
rehoboam_api_url: "http://192.168.1.50:8000"
