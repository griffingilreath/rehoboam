[Unit]
Description=Rehoboam State Engine Service
After=rehoboam-collector.service
Requires=rehoboam-collector.service

[Service]
Type=simple
EnvironmentFile=/etc/rehoboam.env
WorkingDirectory=${REHOBOAM_HOME}
ExecStart=${REHOBOAM_VENV}/bin/python jetson/state_engine_service/main.py --config jetson/state_engine_service/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
