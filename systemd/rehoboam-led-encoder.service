[Unit]
Description=Rehoboam LED Encoder Service
After=rehoboam-state-engine.service
Requires=rehoboam-state-engine.service

[Service]
Type=simple
EnvironmentFile=/etc/rehoboam.env
WorkingDirectory=${REHOBOAM_HOME}
ExecStart=${REHOBOAM_VENV}/bin/python jetson/led_encoder_service/main.py --config jetson/led_encoder_service/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
