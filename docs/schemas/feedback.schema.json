{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rehoboam Feedback Events",
  "type": "object",
  "required": ["schema_version", "generated_at", "timestamp", "feedback"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "timestamp": {"type": "integer", "minimum": 0},
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "timestamp", "recommendation_id", "decision"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "timestamp": {"type": "integer"},
          "recommendation_id": {"type": "string"},
          "decision": {"type": "string", "enum": ["approved", "declined", "snoozed"]},
          "user_id": {"type": "string"},
          "device_id": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    }
  }
}

