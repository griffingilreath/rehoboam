{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rehoboam Events Log",
  "type": "object",
  "required": ["schema_version", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "entity_id", "domain", "state", "summary"],
        "additionalProperties": true,
        "properties": {
          "timestamp": {"type": ["string", "number", "null"]},
          "timestamp_epoch": {"type": "number"},
          "entity_id": {"type": "string"},
          "friendly_name": {"type": ["string", "null"]},
          "domain": {"type": "string"},
          "state": {"type": ["string", "null"]},
          "summary": {"type": "string"},
          "actor": {"type": ["string", "null"]},
          "origin": {"type": ["string", "null"]},
          "context_user_id": {"type": ["string", "null"]},
          "context_parent_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
