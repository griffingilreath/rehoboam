{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rehoboam Raw State",
  "type": "object",
  "required": ["schema_version", "timestamp", "generated_at", "devices", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "timestamp": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "format": "date-time"},
    "devices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {"type": "object"}
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "timestamp": {"type": "integer", "minimum": 0},
        "daypart": {"type": "string"},
        "entities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "occupied": {"type": "boolean"},
            "rain_expected": {"type": "boolean"}
          }
        }
      }
    }
  }
}
