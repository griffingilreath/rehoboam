{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rehoboam Canonical State",
  "type": "object",
  "required": ["schema_version", "timestamp", "generated_at", "leds"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "timestamp": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "format": "date-time"},
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "timestamp": {"type": "integer", "minimum": 0},
        "daypart": {"type": "string"},
        "entities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "occupied": {"type": "boolean"},
            "rain_expected": {"type": "boolean"}
          }
        }
      }
    },
    "leds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "health", "activity_level", "activity_type"],
        "additionalProperties": true,
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "type": {"type": "string"},
          "health": {"type": "string"},
          "activity_level": {"type": "number", "minimum": 0},
          "activity_type": {"type": "string"}
        }
      }
    }
  }
}
